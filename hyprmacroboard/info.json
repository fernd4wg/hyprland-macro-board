{
  "bootloader": "caterina",
  "keyboard_name": "hyprmacroboard",
  "manufacturer": "fernd4wg",
  "url": "https://github.com/fernd4wg/hyprland-macro-board",
  "diode_direction": "COL2ROW",
  "matrix_pins": {
    "cols": ["F4", "F5", "B4"],
    "rows": ["B1", "B3", "B2", "B6", "B5"]
  }
  "usb": {
    "vid": "0x0002",
    "pid": "0x0001",
    "device_version": "0.0.1"
  },
  "features": {
    "oled": true
    "encoder": true,
  },
  "encoder": {
      "rotary": [
        {"pin_a": "F6", "pin_b":"F7", "resolution": 4}
      ]
  },

  "layouts": {
    "LAYOUT": {
      "layout": [
        { "label": "K00", "x": 0, "y": 0, "matrix": [0, 0] },
        { "label": "K01", "x": 1, "y": 0, "matrix": [0, 1] },
        { "label": "K02", "x": 2, "y": 0, "matrix": [0, 2] },

        { "label": "K10", "x": 0, "y": 1, "matrix": [1, 0] },
        { "label": "K11", "x": 1, "y": 1, "matrix": [1, 1] },
        { "label": "K12", "x": 2, "y": 1, "matrix": [1, 2] },

        { "label": "K20", "x": 0, "y": 2, "matrix": [2, 0] },
        { "label": "K21", "x": 1, "y": 2, "matrix": [2, 1] },
        { "label": "K22", "x": 2, "y": 2, "matrix": [2, 2] },

        { "label": "K30", "x": 0, "y": 3, "matrix": [3, 0] },
        { "label": "K31", "x": 1, "y": 3, "matrix": [3, 1] },
        { "label": "K32", "x": 2, "y": 3, "matrix": [3, 2] },

        { "label": "K40", "x": 0, "y": 4, "matrix": [4, 0] },
        { "label": "K41", "x": 1, "y": 4, "matrix": [4, 1] },
        { "label": "K42", "x": 2, "y": 4, "matrix": [4, 2] }
      ]
    }
  }
}

